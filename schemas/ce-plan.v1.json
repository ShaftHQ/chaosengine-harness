{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaosengine.local/schemas/ce-plan.v1.json",
  "title": "ce-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task", "revision", "approval", "steps"],
  "properties": {
    "schema": {"const": "ce-plan/v1"},
    "task": {"type": "string", "minLength": 1, "maxLength": 96},
    "goal": {"type": "string", "maxLength": 500},
    "explanation": {
      "type": "string",
      "maxLength": 500,
      "description": "When 1 to 80 characters, renderers use this as the title. Longer text renders as Plan."
    },
    "revision": {"type": "integer", "minimum": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "state", "revision"],
      "properties": {
        "required": {"type": "boolean"},
        "state": {"enum": ["awaiting", "approved", "stopped"]},
        "revision": {"type": "integer", "minimum": 0},
        "by": {"type": "string"},
        "at": {"type": "string"},
        "ref": {"type": "string"},
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "text"],
            "properties": {
              "step": {"type": "string"},
              "text": {"type": "string", "maxLength": 500}
            }
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/step"}
    },
    "walkthrough": {"type": ["string", "null"]}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "activeText": {"type": "string", "maxLength": 500},
        "intent": {"type": "string", "maxLength": 500},
        "tools": {"type": "array", "items": {"type": "string"}},
        "files": {"type": "array", "items": {"type": "string"}},
        "dependsOn": {"type": "array", "items": {"type": "string"}},
        "verify": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "spec"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "spec": {"type": "string", "minLength": 1}
            }
          }
        },
        "status": {
          "enum": ["pending", "in_progress", "done", "failed", "skipped", "blocked"],
          "description": "Three-state hosts: openbot and codex use pending/inProgress/completed. acp and claude use pending/in_progress/completed. blocked maps to pending. skipped maps to completed. failed maps to pending."
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "note": {"type": "string", "maxLength": 500}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": ["test", "command", "diff", "commit", "pr", "ci", "screenshot", "recording", "url", "review"]
        },
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exit": {"type": "integer"},
        "summary": {"type": "string", "maxLength": 500}
      }
    }
  },
  "description": "Text is whitespace-collapsed and capped at 500 characters. At most 100 steps. Status changes are plan-step rows in the task ledger; this file is the definition plus a cached projection. File evidence stores ref and sha256 and is not copied into git."
}
